# Supabase PostgreSQL (Connection Pooler / Transaction mode - puerto 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL (Direct / Session mode para migraciones - puerto 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT secret
JWT_SECRET="change-me-to-a-secure-random-string"

# URL pública de la aplicación para enlaces en correos
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gmail SMTP (Notificaciones oficiales de pedidos a clientes)
# NOTA: Para Gmail, generar una 'Contraseña de aplicación' (16 caracteres) en https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="tu-cuenta@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="\"Chopper Repuestos\" <tu-cuenta@gmail.com>"

# Modo de pruebas / demo SMTP:
# En entorno de pruebas con lista restringida (SMTP_TEST_MODE="true" y SMTP_ALLOWED_EMAILS definido), solo se transmiten correos a destinatarios incluidos en esa lista.
# Para envío general habilitado a cualquier cliente, establecer SMTP_TEST_MODE="false" o dejar SMTP_ALLOWED_EMAILS vacío.
SMTP_TEST_MODE="false"
# SMTP_ALLOWED_EMAILS="correo1@ejemplo.com,correo2@ejemplo.com"
