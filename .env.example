# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - CHOPPER REPUESTOS (E-COMMERCE)
# Copiá este archivo a `.env` y completá con tus credenciales de Neon, SMTP y Cloudflare R2.
# ==============================================================================

# 1. Neon PostgreSQL - Runtime (Connection Pooler)
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT]-pooler.[REGION].aws.neon.tech/neondb?sslmode=require"

# 2. Neon PostgreSQL - Migraciones CLI (Direct connection)
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].[REGION].aws.neon.tech/neondb?sslmode=require"

# 3. JWT secret
JWT_SECRET="change-me-to-a-secure-random-string"

# 4. URL pública de la aplicación para enlaces en correos
NEXT_PUBLIC_APP_URL="http://localhost:3001"
APP_URL="http://localhost:3001"

# 5. Gmail SMTP (Notificaciones oficiales de pedidos a clientes)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="tu-cuenta@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="\"Chopper Repuestos\" <tu-cuenta@gmail.com>"
SMTP_TEST_MODE="false"
# SMTP_ALLOWED_EMAILS="correo1@ejemplo.com,correo2@ejemplo.com"

# 6. Cloudflare R2 Storage (catálogo, perfiles y comprobantes)
R2_ACCOUNT_ID="tu-account-id"
R2_ACCESS_KEY_ID="tu-access-key-id"
R2_SECRET_ACCESS_KEY="tu-secret-access-key"
R2_BUCKET_NAME="chopper-storage"
R2_ENDPOINT="https://[ACCOUNT_ID].r2.cloudflarestorage.com"
R2_PUBLIC_URL="https://pub-[HASH].r2.dev"
